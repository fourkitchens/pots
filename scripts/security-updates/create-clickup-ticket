#!/bin/bash
#
# Create a ClickUp task for an AutoSec security-update run and print its URL to stdout.
#
# Called by scripts/security-updates/automatic-update via the POTS override/fallback
# pattern; also runnable standalone for testing.
#
# Inputs:
#   $1               Comma-separated list of updated projects (for the ticket body).
#   CU_TOKEN   (env) ClickUp API token. A CircleCI project env var, kept OUT of
#                    SEC_UPDATE_DATA
#                    (pipeline parameters are readable via the CircleCI API/UI).
#   SEC_UPDATE_DATA (env) JSON blob of the non-secret ticketing settings. Keys read here:
#                    list_id, client_id, assignee_id (optional), status (optional).
#   SITE_NAME  (env) Site name, used in the ticket title/body.
#
# Output:
#   The created task URL on stdout (empty when ticketing is unconfigured or the API call
#   fails). All human-readable logging goes to stderr so callers can capture the URL with
#   $( ... ). Always exits 0, so it can never abort the caller's security PR.
#
# SECURITY: never echo CU_TOKEN, and do not enable `set -x` in this script.

set -eo pipefail

PROJECTS_UPDATED="${1:-}"

CU_API="https://api.clickup.com/api/v2"
# Workspace-global custom-field id (constant across 4K projects):
CU_FIELD_CLIENT="b8bbcb75-a7c8-4eb7-9202-e56d227eefbf"    # "Client" field

log() { echo "$@" >&2; }

# Unpack the ClickUp settings from the SEC_UPDATE_DATA pipeline parameter (JSON).
# Only unpack when it holds valid, non-empty JSON; otherwise the CU_* vars stay empty and
# the gate below skips ticket creation.
if [ -n "${SEC_UPDATE_DATA:-}" ] && [ "${SEC_UPDATE_DATA}" != "{}" ] && echo "$SEC_UPDATE_DATA" | jq empty >/dev/null 2>&1; then
  CU_LIST_ID=$(jq -r '.list_id // empty'        <<<"$SEC_UPDATE_DATA")
  CU_CLIENT_ID=$(jq -r '.client_id // empty'    <<<"$SEC_UPDATE_DATA")
  CU_ASSIGNEE_ID=$(jq -r '.assignee_id // empty' <<<"$SEC_UPDATE_DATA")
  CU_STATUS=$(jq -r '.status // empty'          <<<"$SEC_UPDATE_DATA")
fi

# Gate: need the token (env) + list + client. Skip cleanly otherwise.
if ! { [ -n "${CU_TOKEN:-}" ] && [ -n "${CU_LIST_ID:-}" ] && [ -n "${CU_CLIENT_ID:-}" ]; }; then
  log "ClickUp not configured (need CU_TOKEN + list_id + client_id); skipping ticket."
  exit 0
fi

# Resolve the ticket template: consumer override, else the copy beside this script.
if [ -f "./.circleci/scripts/security-updates/TICKET_TEMPLATE.md" ]; then
  TEMPLATE="./.circleci/scripts/security-updates/TICKET_TEMPLATE.md"
else
  TEMPLATE="$(dirname "$0")/TICKET_TEMPLATE.md"
fi

CU_BODY_MESSAGE=$(cat "$TEMPLATE")
CU_BODY_MESSAGE=${CU_BODY_MESSAGE//\[SITE_NAME\]/$SITE_NAME}
CU_BODY_MESSAGE=${CU_BODY_MESSAGE//\[PROJECTS\]/$PROJECTS_UPDATED}
CU_TICKET_TITLE="Security Updates Required For Your Website - ${SITE_NAME}"
START_DATE_MS="$(( $(date +%s) * 1000 ))"   # ms epoch; portable across macOS/Linux

# Build the request body with jq so quotes/newlines in the site name or project list can
# never produce invalid JSON. assignees/status are optional; omitting a status lets the
# list use its own default (a status the list doesn't define would reject the create).
CU_JSON_DATA=$(jq -n \
  --arg name "$CU_TICKET_TITLE" \
  --arg desc "$CU_BODY_MESSAGE" \
  --arg client_id "$CU_CLIENT_ID" \
  --arg client_field "$CU_FIELD_CLIENT" \
  --arg assignee "${CU_ASSIGNEE_ID:-}" \
  --arg status "${CU_STATUS:-}" \
  --argjson start_date "$START_DATE_MS" \
  '{
    name: $name,
    tags: ["autosec update"],
    priority: 2,
    start_date: $start_date,
    start_date_time: false,
    notify_all: false,
    check_required_custom_fields: true,
    custom_fields: [ { id: $client_field, value: $client_id } ],
    description: $desc
  }
  + (if $assignee != "" then { assignees: [ ($assignee | tonumber) ] } else {} end)
  + (if $status   != "" then { status: $status } else {} end)')

log "Creating ClickUp ticket in list ${CU_LIST_ID}..."
RESPONSE_FILE=$(mktemp)
# No -i, so the body is pure JSON we can parse with jq; capture the HTTP status
# separately so a non-2xx never aborts the run.
CU_HTTP=$(curl -s -o "$RESPONSE_FILE" -w "%{http_code}" \
  -X POST "${CU_API}/list/${CU_LIST_ID}/task" \
  -H "Authorization: ${CU_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$CU_JSON_DATA") || CU_HTTP="000"

if [ "$CU_HTTP" = "200" ] || [ "$CU_HTTP" = "201" ]; then
  TICKET_URL=$(jq -r '.url // empty' "$RESPONSE_FILE" 2>/dev/null || true)
  log "ClickUp ticket created: ${TICKET_URL}"
  echo "$TICKET_URL"   # the only stdout: the caller captures this
else
  log "Warning: ClickUp task creation failed (HTTP ${CU_HTTP}); continuing without a ticket."
  log "$(cat "$RESPONSE_FILE" 2>/dev/null || true)"
fi
rm -f "$RESPONSE_FILE"
exit 0
