#!/bin/bash
#
# Run an automated dependency update: update packages, apply the database updates and
# configuration changes they bring with them, push a branch, open a ticket and a PR.
#
# Usage: run-update [security|composer]
#
#   security  (default) update packages with known security advisories. When an advisory
#                       has no fix inside the package's current major, the constraint is
#                       raised and the major is applied: staying vulnerable is worse.
#   composer            routine MINOR updates - minor and patch releases. A major is
#                       applied only for a package whose installed branch is unsupported
#                       (it would otherwise never receive another fix); every other major
#                       is reported in the PR body instead of applied.
#
# Drupal core is always updated as one group, `composer update "drupal/core-*"
# --with-all-dependencies`, in both modes: its packages are released in lockstep and must
# stay on the same version.
#
# The two modes differ only in which packages are selected, which is delegated to an
# overridable select-packages-<mode> script. Everything after that - the Drupal
# environment, updatedb, config export, commits, push, ticket and PR - is shared.

# Exit on error
set -e

UPDATE_MODE="${1:-security}"

echo "Updating projects (mode: $UPDATE_MODE)"
DIR=$(pwd)
COMPOSER_CMD=$(which composer)
NOW=$(date +'%F')
cd $DIR

# Resolve a script or template that ships with POTS, honouring a consumer override in
# ./.circleci/scripts/updates/. Everything this script calls out to must go through
# here: hardcoding the vendor path means a consumer who overrides one file still silently
# gets the vendored copy of the others.
pots_file () {
  if [ -f "./.circleci/scripts/updates/$1" ]; then
    echo "./.circleci/scripts/updates/$1"
  else
    echo "./vendor/fourkitchens/pots/scripts/updates/$1"
  fi
}

source "$( pots_file 4k-openai-lib.sh )"

# Everything that differs between the two modes lives here.
case "$UPDATE_MODE" in
  security)
    BRANCH_NAME="feature/automated-sec-update-$NOW"
    PR_TITLE="(AUTO-SEC): Security updates for $NOW"
    COMMIT_PREFIX="(AUTO-SEC)"
    ;;
  composer)
    BRANCH_NAME="feature/automated-composer-update-$NOW"
    PR_TITLE="(AUTO-UPDATE): Minor composer updates for $NOW"
    COMMIT_PREFIX="(AUTO-UPDATE)"
    ;;
  *)
    echo "Unknown update mode '$UPDATE_MODE' (expected 'security' or 'composer')." >&2
    exit 1
    ;;
esac
PR_TEMPLATE="PULL_REQUEST_TEMPLATE-${UPDATE_MODE}.md"
# Shared with apply-db-updates and setup-drupal-env so every commit this run makes carries
# the same prefix.
export COMMIT_PREFIX

UPDATE_STATE_DIR="${UPDATE_STATE_DIR:-/tmp/pots-update}"
export UPDATE_STATE_DIR
rm -rf "$UPDATE_STATE_DIR"
mkdir -p "$UPDATE_STATE_DIR"

# Ask the mode's selector which packages to update. It prints one package name per line and
# always exits 0, so "nothing to update" is a normal, quiet outcome.
PACKAGES="$( "$( pots_file "select-packages-${UPDATE_MODE}" )" || true )"

MESSAGE=""
TEST_STEPS=""
PROJECTS_UPDATED=""
CONFIG_CHANGES=""

# Helper function to check if branch exist on remote repository.
# Echoes "true" if the branch already exists on the remote, "false" otherwise. It must
# NOT exit: it runs inside $( ... ), so an exit here would only kill the subshell and the
# caller would silently keep working on the current branch (main/master).
gh_branch_exist () {
  if [[ `git ls-remote --heads origin $BRANCH_NAME` ]]; then
    echo "true"
  else
    # Branch does not yet exist
    echo "false"
  fi
}

# Creates a Git branch.
create_gh_branch () {
  # Create the update branch for $NOW. -B rather than `git branch` + `git checkout` so a
  # re-run on a workspace that already has the branch locally resets it instead of dying
  # under `set -e`.
  cd $DIR
  git checkout -B "$BRANCH_NAME"
  echo "true"
}


##
# Drupal core grouping.
#
# Core is not one package. drupal/core, drupal/core-recommended,
# drupal/core-composer-scaffold, drupal/core-project-message and drupal/core-dev are
# released in lockstep and must always sit on the exact same version. Updating them one at
# a time either fails outright -- core-recommended pins core to an exact version -- or
# leaves the set straddling two releases. The documented Drupal procedure is a single
# grouped update, so that is what a selected core package turns into:
#
#   composer update "drupal/core-*" --with-all-dependencies
#
# CORE_TOKEN is the placeholder that stands in for the whole group inside the update loop.
##
CORE_TOKEN='drupal/core-*'

core_update_args() {
  # "drupal/core-*" does not match drupal/core itself (no hyphen). That is normally fine:
  # core-recommended pins core exactly, so --with-all-dependencies drags it along. Add it
  # explicitly only when the project requires drupal/core directly instead.
  printf '%s\n' "$CORE_TOKEN"
  if jq -e '.require["drupal/core"] // empty' composer.json >/dev/null 2>&1; then
    printf '%s\n' 'drupal/core'
  fi
}

# Every drupal/core* package installed, as "name version" pairs.
core_installed_versions() {
  composer show --format=json 2>/dev/null \
    | jq -r '.installed[]? | select(.name | test("^drupal/core(-|$)")) | "\(.name) \(.version)"' \
    || true
}

# Requirement: the core packages must all land on the same version. The grouped update
# should guarantee it, but a stale constraint on one of them can still split the set, and
# a half-upgraded core is the kind of thing that must not reach a reviewer unannounced.
check_core_versions_match() {
  local pairs distinct
  pairs="$( core_installed_versions )"
  [ -z "$pairs" ] && return 0
  distinct="$( printf '%s\n' "$pairs" | awk '{print $2}' | sort -u | wc -l | tr -d ' ' )"
  if [ "$distinct" -gt 1 ]; then
    echo "WARNING: drupal/core* packages are not all on the same version:" >&2
    printf '%s\n' "$pairs" >&2
    printf '%s\n' "drupal/core* packages did not all land on the same version after the grouped update ($( printf '%s' "$pairs" | tr '\n' ';' )). Check the constraints in composer.json before merging." \
      >> "$UPDATE_STATE_DIR/notes"
  fi
}

# Boil a failed composer run down to one reportable line.
#
# Composer prints its dependency conflicts as an indented "Problem N" block, which is the
# part a human needs; everything around it is noise. Fall back to the last few non-empty
# lines when the output does not match that shape (a network error, a plugin blowing up).
summarise_composer_failure() {
  local log="$1" summary
  summary="$( sed -n '/^[[:space:]]*Problem [0-9]/,/^[[:space:]]*$/p' "$log" 2>/dev/null \
    | sed 's/^[[:space:]]*//' | sed '/^$/d' | head -n 8 )"
  if [ -z "$summary" ]; then
    summary="$( grep -v '^[[:space:]]*$' "$log" 2>/dev/null | tail -n 5 )"
  fi
  printf '%s' "$summary" | tr '\n\r\t' '   ' | tr -s ' ' | cut -c1-600 | sed 's/[[:space:]]*$//'
}

# Record a package the run could not update, for the PR body and the ticket.
record_failure() {
  printf '%s\t%s\n' "$1" "$2" >> "$UPDATE_STATE_DIR/failed"
}

# Packages the composer-mode selector marked as safe to take across a major boundary,
# written as "name<TAB>reason" by select-packages-composer.
major_allowed() {
  [ -s "$UPDATE_STATE_DIR/allow-major" ] || return 1
  cut -f1 "$UPDATE_STATE_DIR/allow-major" | grep -qxF "$1"
}

major_allowed_reason() {
  awk -F'\t' -v p="$1" '$1 == p { print $2; exit }' "$UPDATE_STATE_DIR/allow-major" 2>/dev/null
}

# Is this package still covered by a security advisory, with whatever is installed now?
package_still_vulnerable() {
  local pkg="$1"
  composer audit --format=json 2>/dev/null \
    | jq -e --arg p "$pkg" '(.advisories // {}) | has($p)' >/dev/null 2>&1
}

# Newest release composer knows about for a package, ignoring the project's constraints.
latest_available_version() {
  local pkg="$1"
  composer outdated "$pkg" --all --format=json 2>/dev/null \
    | jq -r --arg p "$pkg" '.installed[]? | select(.name == $p) | .latest // empty' \
    | head -n 1
}

installed_version() {
  local pkg="$1"
  composer show "$pkg" --format=json 2>/dev/null | jq -r '.versions[0] // empty' | head -n 1
}

 # Only do any work when the selector actually found something.
if [ -n "$PACKAGES" ]; then
  # Fold every selected drupal/core* package into the single CORE_TOKEN entry, and put it
  # first so contrib resolves against the new core rather than the old one.
  if printf '%s\n' "$PACKAGES" | grep -qE '^drupal/core(-[a-z-]+)?$'; then
    echo "Core packages selected ($( printf '%s\n' "$PACKAGES" | grep -E '^drupal/core(-[a-z-]+)?$' | tr '\n' ' ')); updating them as one group."
    PACKAGES="$( printf '%s\n' "$PACKAGES" | grep -vE '^drupal/core(-[a-z-]+)?$' || true )"
    PACKAGES="$( printf '%s\n%s\n' "$CORE_TOKEN" "$PACKAGES" | sed '/^$/d' )"
  fi
  echo "Packages to update: $(echo "$PACKAGES" | tr '\n' ' ')"
  if [[ $(gh_branch_exist) == "false" ]]
  then
    echo "Creating Git branch for the sec update..."
    create_gh_branch
    echo "Git branch created."
  else
    echo "Branch $BRANCH_NAME already exists; checking it out."
    git checkout "$BRANCH_NAME"
  fi

  # Stand up a working Drupal site so the database updates that ship with these security
  # releases can be run and any configuration they change can be exported. This is only
  # worth doing once we know there is something to update. A failure here is recorded and
  # reported in the PR body, but must not stop the security updates themselves.
  if [[ "${UPDATE_RUN_DB_UPDATES:-YES}" != "NO" ]]; then
    echo "Preparing the Drupal environment for database updates..."
    "$( pots_file setup-drupal-env )" || true
  else
    echo "UPDATE_RUN_DB_UPDATES is 'NO'. Skipping database updates and configuration export."
    : > "$UPDATE_STATE_DIR/disabled"
  fi

  # Update one package at a time. This is a *partial* composer update, which matters: a full
  # `composer update` re-resolves the whole graph and can fail for reasons unrelated to the
  # packages we want to move (an advisory-blocked pin, a path-repo branch mismatch). Partial
  # updates sidestep that, and they give per-package commits a reviewer can follow.
  while IFS= read -r PROJECT; do
    [ -z "$PROJECT" ] && continue
    cd $DIR
    # The core group is several packages behind one token. PROJECT_LABEL is what the PR,
    # the commits and the AI prompt should call it; PROJECT stays the composer argument.
    if [ "$PROJECT" = "$CORE_TOKEN" ]; then
      PROJECT_LABEL="drupal/core"
      IS_CORE_GROUP="yes"
      UPDATE_TARGETS=()
      while IFS= read -r CORE_ARG; do
        [ -n "$CORE_ARG" ] && UPDATE_TARGETS+=( "$CORE_ARG" )
      done < <( core_update_args )
    else
      PROJECT_LABEL="$PROJECT"
      IS_CORE_GROUP="no"
      UPDATE_TARGETS=( "$PROJECT" )
    fi
    echo "Updating $PROJECT_LABEL"
    echo "-----------------"
    VERSION_BEFORE="$( installed_version "$PROJECT_LABEL" )"
    # Core moves as a set, so it needs --with-all-dependencies; a single package is kept to
    # --with-dependencies, which is the narrower, more predictable partial update.
    if [ "$IS_CORE_GROUP" = "yes" ]; then
      UPDATE_FLAG="--with-all-dependencies"
    else
      UPDATE_FLAG="--with-dependencies"
    fi
    # A package can legitimately refuse to move (an exact version pin, a conflicting
    # dependency). That does not fail the run -- the other packages still get updated --
    # but it must not vanish either: a package nobody notices is stuck is a package that
    # stays un-updated for months. Capture the reason for the PR body and the ticket.
    UPDATE_LOG="$UPDATE_STATE_DIR/update-$( printf '%s' "$PROJECT_LABEL" | tr '/*' '--' ).log"
    if ! $COMPOSER_CMD update "${UPDATE_TARGETS[@]}" "$UPDATE_FLAG" > "$UPDATE_LOG" 2>&1; then
      cat "$UPDATE_LOG" >&2
      FAILURE_REASON="$( summarise_composer_failure "$UPDATE_LOG" )"
      record_failure "$PROJECT_LABEL" "${FAILURE_REASON:-composer update failed; see the CI log.}"
      echo "Could not update $PROJECT_LABEL; recorded for the PR and skipping it."
      continue
    fi
    cat "$UPDATE_LOG" >&2
    [ "$IS_CORE_GROUP" = "yes" ] && check_core_versions_match

    ##
    # The two cases where a run is allowed to cross a major boundary.
    #
    # A partial `composer update` can only move a package inside the constraint already in
    # composer.json, so crossing a major means rewriting that constraint with
    # `composer require`. Both cases below are ones where NOT crossing it is the worse
    # outcome, and both are reported prominently in the PR body.
    #
    #   security mode  the advisory has no fix inside the current major: the module was
    #                  never patched on the branch this site is pinned to, so a normal
    #                  update is a no-op and the site stays vulnerable.
    #
    #   composer mode  the installed branch is unsupported (see select-packages-composer).
    #                  An unsupported branch gets no further fixes of any kind, security
    #                  included, so staying on it is not the safe choice it looks like.
    #                  Drupal core is deliberately excluded: a core major is a planned
    #                  project, not routine maintenance.
    ##
    MAJOR_UPGRADE_NOTE=""
    ALLOW_MAJOR="no"
    MAJOR_REASON=""
    if [ "$UPDATE_MODE" = "security" ] && package_still_vulnerable "$PROJECT_LABEL"; then
      ALLOW_MAJOR="yes"
      MAJOR_REASON="No security fix was available within the previous major"
    elif [ "$UPDATE_MODE" = "composer" ] && [ "$IS_CORE_GROUP" != "yes" ] && major_allowed "$PROJECT_LABEL"; then
      ALLOW_MAJOR="yes"
      MAJOR_REASON="$( major_allowed_reason "$PROJECT_LABEL" )"
    fi
    if [ "$ALLOW_MAJOR" = "yes" ]; then
      LATEST="$( latest_available_version "$PROJECT_LABEL" )"
      CURRENT="$( installed_version "$PROJECT_LABEL" )"
      if [ -n "$LATEST" ] && [ "$LATEST" != "$CURRENT" ]; then
        NEW_MAJOR="${LATEST%%.*}"
        NEW_MAJOR="${NEW_MAJOR#v}"
        echo "$PROJECT_LABEL needs a major upgrade at ${CURRENT:-unknown}: ${MAJOR_REASON}."
        echo "Raising the constraint to ^${NEW_MAJOR}.0 and applying the major upgrade."
        if [ "$IS_CORE_GROUP" = "yes" ]; then
          # Raise every drupal/core* entry in composer.json together, or they end up split.
          REQUIRE_ARGS=()
          while IFS= read -r CORE_PKG; do
            [ -n "$CORE_PKG" ] && REQUIRE_ARGS+=( "${CORE_PKG}:^${NEW_MAJOR}.0" )
          done < <( jq -r '(.require // {}) | keys[]? | select(test("^drupal/core(-|$)"))' composer.json 2>/dev/null )
        else
          REQUIRE_ARGS=( "${PROJECT_LABEL}:^${NEW_MAJOR}.0" )
        fi
        if [ ${#REQUIRE_ARGS[@]} -gt 0 ] && $COMPOSER_CMD require "${REQUIRE_ARGS[@]}" --with-all-dependencies --no-interaction; then
          [ "$IS_CORE_GROUP" = "yes" ] && check_core_versions_match
          MAJOR_UPGRADE_NOTE="  - :rotating_light: **Major upgrade applied** (${CURRENT:-unknown} -> $( installed_version "$PROJECT_LABEL" )). ${MAJOR_REASON}, so the constraint in composer.json was raised to \`^${NEW_MAJOR}.0\`. Majors can contain breaking changes - review and test this one before merging."
          if [ "$UPDATE_MODE" = "security" ] && package_still_vulnerable "$PROJECT_LABEL"; then
            MAJOR_UPGRADE_NOTE+="\n  - :warning: $PROJECT_LABEL is **still flagged by \`composer audit\`** after the major upgrade. It needs attention by hand."
          fi
        else
          echo "Could not raise $PROJECT_LABEL to ^${NEW_MAJOR}.0; leaving it as it is."
          record_failure "$PROJECT_LABEL" "Needed a major upgrade to ^${NEW_MAJOR}.0 (${MAJOR_REASON}), but composer could not resolve it."
        fi
      elif [ -z "$LATEST" ]; then
        record_failure "$PROJECT_LABEL" "Needed a major upgrade (${MAJOR_REASON}) but no newer release exists, so there is no automatic fix."
      fi
    fi
    # Check for any changes
    if [[ `git status --porcelain` ]]; then
        #committing recent changes.
        git add composer.*
        git commit -m "${COMMIT_PREFIX}: Updated project $PROJECT_LABEL"

        # Run the database updates this package brings with it and commit any configuration
        # they changed. Always exits 0; prints a Markdown summary for the PR body.
        DB_SUMMARY=$( "$( pots_file apply-db-updates )" "$PROJECT_LABEL" )
        if [ -n "$DB_SUMMARY" ]; then
          CONFIG_CHANGES+="${DB_SUMMARY}\n"
        fi

        # Building PR information.
        # Remove prefix "drupal/" from the project name
        AUX=${PROJECT_LABEL//drupal\//''}
        PROJECTS_UPDATED+="${AUX}, "
        if [ "$IS_CORE_GROUP" = "yes" ]; then
          AUX="- Update [Drupal core](https://www.drupal.org/project/drupal/releases) (\`drupal/core-*\`, updated as one group)."
        elif [[ "$PROJECT_LABEL" != drupal/* ]]; then
          # Not a Drupal project, so there is no drupal.org release page to link.
          AUX="- Update [${PROJECT_LABEL}](https://packagist.org/packages/${PROJECT_LABEL})."
        elif [ $AUX == 'core' ] || [ $AUX == 'core-recommended' ] || [ $AUX == 'core-composer-scaffold' ]; then
          AUX="- Update [${PROJECT_LABEL}](https://www.drupal.org/project/drupal/releases)."
        else
          AUX="- Update the contrib module: [${PROJECT_LABEL}](https://www.drupal.org/project/${AUX}/releases)."
        fi
        MESSAGE+="${AUX}\n"
        # Flag a crossed major boundary directly under the package it applies to.
        if [ -n "$MAJOR_UPGRADE_NOTE" ]; then
          MESSAGE+="${MAJOR_UPGRADE_NOTE}\n"
        fi
        # AI-generated testing steps (optional). A failure here must never abort the
        # update run, so the call is non-fatal and we only append when it returned text.
        if [ -n "${OPENAI_API_KEY}" ]; then
          if [ "$UPDATE_MODE" = "security" ]; then
            PROMPT_TEXT="I am updating the following drupal project: $PROJECT_LABEL, because a security update, could you give me functional testing instructions for it?"
          else
            PROMPT_TEXT="I am applying a routine minor update to the following drupal project: $PROJECT_LABEL, could you give me functional testing instructions for it?"
          fi
          # Tell the model what the update actually did, so the steps target the areas that
          # changed instead of being generic.
          if [ -n "$DB_SUMMARY" ]; then
            PROMPT_TEXT+=$'\n\nThe update ran these database updates and changed these configuration files:\n'
            PROMPT_TEXT+="$DB_SUMMARY"
          fi
          OPENAI_RESPONSE=$(openai_request "$OPENAI_API_KEY" "$PROMPT_TEXT" || true)
          if [ -n "$OPENAI_RESPONSE" ]; then
            TEST_STEPS+="### AI testing instructions for the project ${PROJECT_LABEL}:\n"
            TEST_STEPS+="${OPENAI_RESPONSE}\n"
          fi
        fi
        echo "Updated $PROJECT_LABEL"
        echo "---------------"
    fi
  done <<< "$PACKAGES"
  echo "Projects updated"
  echo "---------------"

  cd $DIR

  # Create the ClickUp ticket + the PR.
  if [ -z "$MESSAGE" ]
  then
    echo "Nothing to update."
  else
    echo "Pushing update changes to remote repo"
    echo "-------------------------------------------"
    git push --set-upstream origin $BRANCH_NAME


    # Fold the database/configuration results, and any warnings the database phase
    # recorded, into one section of the PR body.
    if [ -f "$UPDATE_STATE_DIR/notes" ]; then
      while IFS= read -r LINE; do
        [ -n "$LINE" ] && CONFIG_CHANGES+="- :warning: ${LINE}\n"
      done < "$UPDATE_STATE_DIR/notes"
    fi
    # Major upgrades the selector deliberately did not apply. Surfacing them is the point:
    # the team needs to know a major is waiting, and that a human has to plan it.
    BLOCKED_UPDATES=""
    if [ -s "$UPDATE_STATE_DIR/blocked" ]; then
      while IFS= read -r LINE; do
        [ -n "$LINE" ] && BLOCKED_UPDATES+="- \`${LINE}\`\n"
      done < "$UPDATE_STATE_DIR/blocked"
    fi
    if [ -z "$BLOCKED_UPDATES" ]; then
      BLOCKED_UPDATES="_None._"
    fi

    # Packages that could not be updated. Two renderings of the same list: Markdown for
    # the PR body, and a plain-text version for the ticket, whose description is read by
    # someone who is not looking at composer output.
    FAILED_UPDATES=""
    FAILED_PLAIN=""
    if [ -s "$UPDATE_STATE_DIR/failed" ]; then
      while IFS=$'\t' read -r FNAME FREASON; do
        [ -z "$FNAME" ] && continue
        FAILED_UPDATES+="- :x: \`${FNAME}\` - ${FREASON}\n"
        FAILED_PLAIN+="- ${FNAME}: ${FREASON}\n"
      done < "$UPDATE_STATE_DIR/failed"
    fi
    if [ -z "$FAILED_UPDATES" ]; then
      FAILED_UPDATES="_None._"
      FAILED_PLAIN="None."
    else
      echo "Some packages could not be updated; they are reported in the PR and the ticket."
    fi
    export UPDATE_FAILURES="$FAILED_PLAIN"

    if [ -z "$CONFIG_CHANGES" ]; then
      CONFIG_CHANGES="_No database updates or configuration changes came with these security updates._"
    fi

    # Open a ticket first, so its URL can be linked in the PR body. The provider script
    # gates itself on its own configuration, prints the ticket URL (empty when it is
    # unconfigured or its API call fails) and always exits 0, so ticketing can never fail
    # the security PR.
    #
    # TICKETING_SYSTEM is a CircleCI project env var, so moving a project from ClickUp to
    # Productive is a one-click change that leaves its trigger POST alone.
    TICKET_URL=""
    case "${TICKETING_SYSTEM:-clickup}" in
      none)
        echo "Ticketing is disabled (TICKETING_SYSTEM=none)."
        ;;
      clickup|productive)
        TICKET_SCRIPT=$( pots_file "create-${TICKETING_SYSTEM:-clickup}-ticket" )
        if [ -x "$TICKET_SCRIPT" ]; then
          TICKET_URL=$( UPDATE_MODE="$UPDATE_MODE" "$TICKET_SCRIPT" "$PROJECTS_UPDATED" || true)
        else
          echo "No ticket script found at ${TICKET_SCRIPT}; skipping ticketing."
        fi
        ;;
      *)
        echo "Unknown TICKETING_SYSTEM '${TICKETING_SYSTEM}' (expected clickup, productive or none); skipping ticketing."
        ;;
    esac

    # Create the PR, linking the ticket if one was created.
    echo "Creating the update Pull request."
    echo "-------------------------------------------"
    if [ -z "$TICKET_URL" ]; then
      TICKET_URL="_No ticket was created for this update._"
    fi
    BODY=$(cat "$( pots_file "$PR_TEMPLATE" )")
    BODY=${BODY//\[UPDATED_MODULES\]/$MESSAGE}
    BODY=${BODY//\[CONFIG_CHANGES\]/$CONFIG_CHANGES}
    BODY=${BODY//\[BLOCKED_UPDATES\]/$BLOCKED_UPDATES}
    BODY=${BODY//\[FAILED_UPDATES\]/$FAILED_UPDATES}
    BODY=${BODY//\[ADDITIONAL_TESTING\]/$TEST_STEPS}
    BODY=${BODY//\[TICKET_URL\]/$TICKET_URL}
    if [ ! -z "$SITE_NAME" ]; then
      BODY=${BODY//\[PROJECT_NAME\]/$SITE_NAME}
    fi
    # The body carries free-form text -- the AI testing steps and the database/config
    # summary -- so it can contain double quotes and backslashes. Hand-building the JSON
    # with printf escaped newlines only, and a single quote in the model's output was
    # enough to make GitHub reject the whole request with HTTP 400. Let jq encode it.
    # The template's own sections carry literal "\n" escapes rather than real newlines,
    # so turn those into real ones first. Substitution rather than printf '%b': %b would
    # also expand any other backslash sequence the model happened to emit, so a Windows
    # path in the testing steps would come out with a tab in it.
    BODY_JSON=${BODY//\\n/$'\n'}
    PARAMETERS=$(jq -n \
      --arg title "$PR_TITLE" \
      --arg body  "$BODY_JSON" \
      --arg head  "$BRANCH_NAME" \
      --arg base  "$CIRCLE_BRANCH" \
      '{title: $title, body: $body, head: $head, base: $base}')

    # Running the request
    response=$( \
        curl -sw "%{http_code}" -L \
        -X POST \
        -H "Accept: application/vnd.github+json" \
        -H "Authorization: Bearer $GITHUB_TOKEN" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        https://api.github.com/repos/$CIRCLE_PROJECT_USERNAME/$CIRCLE_PROJECT_REPONAME/pulls \
        -d "$PARAMETERS" \
    )

    # Extracting the HTTP status code from the response
    http_status="${response: -3}"
    response_body="${response%???}"

    if [ "$http_status" == "200" -o "$http_status" == "201" ]; then
      echo "Pull request: $PR_TITLE successfully created."
      echo "-------------------------------------------"

      # The PR number only exists once the PR does, so the environment links in the template
      # have to be filled in with a follow-up update. Without this the placeholders ship
      # literally in the body. Non-fatal: the PR itself is already created.
      PR_NUMBER=$(echo "$response_body" | jq -r '.number // empty' 2>/dev/null || true)
      if [ -n "$PR_NUMBER" ]; then
        FINAL_BODY=${BODY//\[PR_NUMBER\]/$PR_NUMBER}
        FINAL_BODY=${FINAL_BODY//\[PR-NUMBER\]/$PR_NUMBER}
        FINAL_BODY=${FINAL_BODY//\[PROJECT\]/$SITE_NAME}
        # Same literal "\n" expansion as the create request above, and the same reason for
        # preferring substitution over printf '%b'.
        FINAL_BODY=${FINAL_BODY//\\n/$'\n'}
        curl -sS -o /dev/null -L \
          -X PATCH \
          -H "Accept: application/vnd.github+json" \
          -H "Authorization: Bearer $GITHUB_TOKEN" \
          -H "X-GitHub-Api-Version: 2022-11-28" \
          https://api.github.com/repos/$CIRCLE_PROJECT_USERNAME/$CIRCLE_PROJECT_REPONAME/pulls/$PR_NUMBER \
          -d "$(jq -n --arg body "$FINAL_BODY" '{body: $body}')" || true
      fi
    else
      echo "Failed to create pull request: $PR_TITLE. HTTP status code: $http_status"
      # Without this the response body is captured and thrown away, leaving a bare status
      # code with no indication of what GitHub objected to.
      echo "$response_body" | jq -r '[.message // empty] + [.errors[]?.message // empty] | .[]' 2>/dev/null \
        || echo "$response_body"
      echo "-------------------------------------------"
      exit 1
    fi
  fi
else
  echo "Nothing to do! No available security updates."
fi
